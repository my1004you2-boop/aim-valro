{
  "name": "headline-aim",
  "productName": "Headline Aim",
  "version": "0.1.0",
  "description": "Valorant-style headshot aim trainer",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env ELECTRON_RUN_AS_NODE= VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && cross-env ELECTRON_RUN_AS_NODE= electron .",
    "test": "vitest run",
    "dist": "vite build && electron-builder --win"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  }
}
